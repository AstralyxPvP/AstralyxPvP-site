{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astralyxpvp",
  "compatibility_date": "2026-05-10",
  "pages_build_output_dir": ".",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // ── D1 Database binding for Web Announcements ─────────────────────────
  "d1_databases": [
    {
      "binding": "DB",                         // accessed as env.DB in functions
      "database_name": "astralyx-db",
      "database_id": "34f12896-1924-4dd8-8566-9f1b0afeecc1"
    },
    {
      "binding": "MINECRAFT_STATUS_DB",
      "database_name": "astralyxpvp-minecraft-status",
      "database_id": "c39b1a12-2c59-43b3-b9a7-266eccf4e42b"
    }
  ],
  "services": [
    {
      "binding": "STATUS_MONITOR",
      "service": "astralyxpvp-status-monitor"
    }
  ]
}
